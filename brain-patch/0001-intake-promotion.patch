index dad1504..26d8123 100644
--- a/src/services/missing-files.js
+++ b/src/services/missing-files.js
@@ -137,4 +137,20 @@ async function allLiveDriveIds() {
   return ids;
 }
 
-module.exports = { hideMissing, restoreIfBack, allLiveDriveIds };
+/** Drive ids of museum downloads promoted into the catalog (they sit outside the main root). */
+async function intakeDriveIds() {
+  const ids = new Set();
+  let after = "";
+  for (;;) {
+    const { data, error } = await supabase.from("intake_queue").select("drive_file_id")
+      .eq("status", "promoted").gt("drive_file_id", after).order("drive_file_id").limit(1000);
+    if (error) throw new Error(`missing-files intake list: ${error.message}`);
+    if (!data?.length) break;
+    for (const r of data) ids.add(r.drive_file_id);
+    after = data[data.length - 1].drive_file_id;
+    if (data.length < 1000) break;
+  }
+  return ids;
+}
+
+module.exports = { hideMissing, restoreIfBack, allLiveDriveIds, intakeDriveIds };
